// Calculated tables for the Baraka model
// Create each with Modeling > New table

// ---- Date table: mark as date table on [Date] ----
// Sort Month by Month Number, and Month Year by Year Month Key
Date =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2023, 1, 1 ), DATE ( 2025, 12, 31 ) ),
    "Year", YEAR ( [Date] ),
    "Quarter", "Q" & QUARTER ( [Date] ),
    "Month Number", MONTH ( [Date] ),
    "Month", FORMAT ( [Date], "mmm" ),
    "Year Month Key", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
    "Month Year", FORMAT ( [Date], "mmm yyyy" )
)

// ---- Segment table: one row per segment ----
// Sort segment by segment_order
Segment =
DATATABLE (
    "segment", STRING,
    "segment_order", INTEGER,
    {
        { "Supermarkets", 1 },
        { "Distributors", 2 },
        { "Small shops", 3 },
        { "Hotels and restaurants", 4 },
        { "Government", 5 }
    }
)
