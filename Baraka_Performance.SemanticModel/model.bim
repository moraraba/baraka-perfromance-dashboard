          },
          {
            "name": "target_sales_kes",
            "dataType": "int64",
            "sourceColumn": "target_sales_kes",
            "summarizeBy": "sum",
            "isHidden": true,
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "baraka-targets",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"baraka-targets.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"month\", type date}, {\"segment\", type text}, {\"target_sales_kes\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "baraka-products",
        "columns": [
          {
            "name": "product",
            "dataType": "string",
            "sourceColumn": "product",
            "summarizeBy": "none"
          },
          {
            "name": "category",
            "dataType": "string",
            "sourceColumn": "category",
            "summarizeBy": "none"
          },
          {
            "name": "pack_size",
            "dataType": "string",
            "sourceColumn": "pack_size",
            "summarizeBy": "none"
          },
          {
            "name": "standard_cost_kes",
            "dataType": "int64",
            "sourceColumn": "standard_cost_kes",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "list_price_kes",
            "dataType": "int64",
