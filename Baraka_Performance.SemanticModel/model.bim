        "fromTable": "baraka-targets",
        "fromColumn": "month",
        "toTable": "Date",
        "toColumn": "Date"
      },
      {
        "name": "e50e4dca-e2a6-4bd3-8355-285dbdb5a964",
        "fromTable": "baraka-sales",
