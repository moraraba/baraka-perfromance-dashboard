          },
          {
            "name": "launched",
            "dataType": "int64",
            "sourceColumn": "launched",
            "summarizeBy": "none",
            "formatString": "0"
          }
        ],
        "partitions": [
          {
            "name": "baraka-products",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"baraka-products.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"product\", type text}, {\"category\", type text}, {\"pack_size\", type text}, {\"standard_cost_kes\", Int64.Type}, {\"list_price_kes\", Int64.Type}, {\"launched\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "baraka-markets",
        "columns": [
          {
            "name": "market",
            "dataType": "string",
            "sourceColumn": "market",
            "summarizeBy": "none"
          },
          {
            "name": "country",
            "dataType": "string",
            "sourceColumn": "country",
            "summarizeBy": "none"
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none"
          },
          {
            "name": "market_type",
            "dataType": "string",
            "sourceColumn": "market_type",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "baraka-markets",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"baraka-markets.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"market\", type text}, {\"country\", type text}, {\"region\", type text}, {\"market_type\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Date",
        "dataCategory": "Time",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Date",
            "dataType": "dateTime",
            "isNameInferred": true,
            "sourceColumn": "[Date]",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd",
            "isKey": true
          },
          {
            "type": "calculatedTableColumn",
            "name": "Year",
            "dataType": "int64",
            "isNameInferred": true,
            "sourceColumn": "[Year]",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Quarter",
            "dataType": "string",
            "isNameInferred": true,
            "sourceColumn": "[Quarter]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Month Number",
            "dataType": "int64",
            "isNameInferred": true,
            "sourceColumn": "[Month Number]",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Month",
            "dataType": "string",
            "isNameInferred": true,
            "sourceColumn": "[Month]",
            "summarizeBy": "none",
            "sortByColumn": "Month Number"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Year Month Key",
            "dataType": "int64",
            "isNameInferred": true,
            "sourceColumn": "[Year Month Key]",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Month Year",
            "dataType": "string",
            "isNameInferred": true,
            "sourceColumn": "[Month Year]",
            "summarizeBy": "none",
            "sortByColumn": "Year Month Key"
          }
        ],
        "partitions": [
          {
            "name": "Date",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "ADDCOLUMNS (",
                "    CALENDAR ( DATE ( 2023, 1, 1 ), DATE ( 2025, 12, 31 ) ),",
                "    \"Year\", YEAR ( [Date] ),",
                "    \"Quarter\", \"Q\" & QUARTER ( [Date] ),",
                "    \"Month Number\", MONTH ( [Date] ),",
                "    \"Month\", FORMAT ( [Date], \"mmm\" ),",
                "    \"Year Month Key\", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),",
                "    \"Month Year\", FORMAT ( [Date], \"mmm yyyy\" )",
                ")"
              ]
            }
          }
        ]
      },
      {
        "name": "Segment",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "segment",
            "dataType": "string",
            "isNameInferred": true,
            "sourceColumn": "[segment]",
            "summarizeBy": "none",
            "sortByColumn": "segment_order"
          },
          {
            "type": "calculatedTableColumn",
            "name": "segment_order",
            "dataType": "int64",
            "isNameInferred": true,
            "sourceColumn": "[segment_order]",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0"
          }
        ],
        "partitions": [
          {
            "name": "Segment",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "DATATABLE (",
                "    \"segment\", STRING,",
                "    \"segment_order\", INTEGER,",
                "    {",
                "        { \"Supermarkets\", 1 },",
                "        { \"Distributors\", 2 },",
                "        { \"Small shops\", 3 },",
                "        { \"Hotels and restaurants\", 4 },",
                "        { \"Government\", 5 }",
                "    }",
                ")"
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "f0c6c648-c996-4d50-87ed-53431963d019",
        "fromTable": "baraka-sales",
        "fromColumn": "month",
        "toTable": "Date",
        "toColumn": "Date"
      },
      {
