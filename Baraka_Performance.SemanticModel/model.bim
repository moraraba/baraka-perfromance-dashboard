        "toTable": "Segment",
        "toColumn": "segment"
      },
      {
        "name": "f652b289-c66b-44ec-a876-4f2f4b7a6673",
        "fromTable": "baraka-targets",
        "fromColumn": "segment",
        "toTable": "Segment",
        "toColumn": "segment"
      },
      {
        "name": "6227ddb6-5595-43b3-9b3e-30f71c8ff67b",
        "fromTable": "baraka-sales",
        "fromColumn": "product",
        "toTable": "baraka-products",
        "toColumn": "product"
      },
      {
        "name": "a0f37b9f-7170-411d-b8f1-9c8d61f67677",
        "fromTable": "baraka-sales",
        "fromColumn": "market",
        "toTable": "baraka-markets",
        "toColumn": "market"
      }
    ],
    "expressions": [
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:\\Baraka\\data\\\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBI_QueryOrder",
        "value": "[\"DataFolder\", \"baraka-sales\", \"baraka-targets\", \"baraka-products\", \"baraka-markets\"]"
      }
    ]
  }
}