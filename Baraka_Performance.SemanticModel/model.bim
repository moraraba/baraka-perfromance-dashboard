{
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "baraka-sales",
        "columns": [
          {
            "name": "sale_id",
            "dataType": "int64",
            "sourceColumn": "sale_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "month",
            "dataType": "dateTime",
            "sourceColumn": "month",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "segment",
            "dataType": "string",
            "sourceColumn": "segment",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "market",
            "dataType": "string",
            "sourceColumn": "market",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "product",
            "dataType": "string",
            "sourceColumn": "product",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "discount_band",
            "dataType": "string",
            "sourceColumn": "discount_band",
            "summarizeBy": "none",
            "sortByColumn": "band_order"
          },
          {
            "name": "units_sold",
            "dataType": "int64",
            "sourceColumn": "units_sold",
            "summarizeBy": "sum",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "sale_price_kes",
            "dataType": "int64",
            "sourceColumn": "sale_price_kes",
            "summarizeBy": "sum",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "gross_sales_kes",
            "dataType": "int64",
            "sourceColumn": "gross_sales_kes",
            "summarizeBy": "sum",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "discounts_kes",
            "dataType": "int64",
            "sourceColumn": "discounts_kes",
            "summarizeBy": "sum",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "sales_kes",
            "dataType": "int64",
            "sourceColumn": "sales_kes",
            "summarizeBy": "sum",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "cogs_kes",
            "dataType": "int64",
            "sourceColumn": "cogs_kes",
            "summarizeBy": "sum",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "profit_kes",
            "dataType": "int64",
            "sourceColumn": "profit_kes",
            "summarizeBy": "sum",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "band_order",
            "dataType": "int64",
            "sourceColumn": "band_order",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "baraka-sales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"baraka-sales.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"sale_id\", Int64.Type}, {\"month\", type date}, {\"segment\", type text}, {\"market\", type text}, {\"product\", type text}, {\"discount_band\", type text}, {\"units_sold\", Int64.Type}, {\"sale_price_kes\", Int64.Type}, {\"gross_sales_kes\", Int64.Type}, {\"discounts_kes\", Int64.Type}, {\"sales_kes\", Int64.Type}, {\"cogs_kes\", Int64.Type}, {\"profit_kes\", Int64.Type}}, \"en-US\"),",
                "    BandOrder = Table.AddColumn(Typed, \"band_order\", each if [discount_band] = \"None\" then 1 else if [discount_band] = \"Low\" then 2 else if [discount_band] = \"Medium\" then 3 else 4, Int64.Type)",
                "in",
                "    BandOrder"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Sales",
            "expression": "SUM ( 'baraka-sales'[sales_kes] )",
            "formatString": "#,0",
            "displayFolder": "1 Core"
          },
          {
            "name": "Gross Sales",
            "expression": "SUM ( 'baraka-sales'[gross_sales_kes] )",
            "formatString": "#,0",
            "displayFolder": "1 Core"
          },
          {
            "name": "Total Discounts",
            "expression": "SUM ( 'baraka-sales'[discounts_kes] )",
            "formatString": "#,0",
            "displayFolder": "1 Core"
          },
          {
            "name": "Discount %",
            "expression": "DIVIDE ( [Total Discounts], [Gross Sales] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "1 Core"
          },
          {
            "name": "Total COGS",
            "expression": "SUM ( 'baraka-sales'[cogs_kes] )",
            "formatString": "#,0",
            "displayFolder": "1 Core"
          },
          {
            "name": "Total Profit",
            "expression": "SUM ( 'baraka-sales'[profit_kes] )",
            "formatString": "#,0",
            "displayFolder": "1 Core"
          },
          {
            "name": "Profit Margin",
            "expression": "DIVIDE ( [Total Profit], [Total Sales] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "1 Core"
          },
          {
            "name": "Units Sold",
            "expression": "SUM ( 'baraka-sales'[units_sold] )",
            "formatString": "#,0",
            "displayFolder": "1 Core"
          },
          {
            "name": "Sales Last Year",
            "expression": "CALCULATE ( [Total Sales], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )",
            "formatString": "#,0",
            "displayFolder": "2 Time intelligence"
          },
          {
            "name": "Sales Growth %",
            "expression": "DIVIDE ( [Total Sales] - [Sales Last Year], [Sales Last Year] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "2 Time intelligence"
          },
          {
            "name": "Sales YTD",
            "expression": "TOTALYTD ( [Total Sales], 'Date'[Date] )",
            "formatString": "#,0",
            "displayFolder": "2 Time intelligence"
          },
          {
            "name": "Profit Last Year",
            "expression": "CALCULATE ( [Total Profit], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )",
            "formatString": "#,0",
            "displayFolder": "2 Time intelligence"
          },
          {
            "name": "Profit Growth %",
            "expression": "DIVIDE ( [Total Profit] - [Profit Last Year], [Profit Last Year] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "2 Time intelligence"
          },
          {
            "name": "Sales 2023",
            "expression": "CALCULATE ( [Total Sales], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 )",
            "formatString": "#,0",
            "displayFolder": "2 Time intelligence"
          },
          {
            "name": "Sales Growth vs 2023 %",
            "expression": "DIVIDE ( [Total Sales] - [Sales 2023], [Sales 2023] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "2 Time intelligence"
          },
          {
            "name": "Target Sales",
            "expression": [
              "SUMX (",
              "    VALUES ( Segment[segment] ),",
              "    VAR SegmentTarget = CALCULATE ( SUM ( 'baraka-targets'[target_sales_kes] ) )",
              "    VAR Share =",
              "        DIVIDE (",
              "            CALCULATE ( [Total Sales], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ),",
              "            CALCULATE (",
              "                [Total Sales],",
              "                REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023,",
              "                REMOVEFILTERS ( 'baraka-markets' ),",
              "                REMOVEFILTERS ( 'baraka-products' )",
              "            )",
              "        )",
              "    RETURN SegmentTarget * Share",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "3 Plan"
          },
          {
            "name": "Variance to Target",
            "expression": "[Total Sales] - [Target Sales]",
            "formatString": "#,0",
            "displayFolder": "3 Plan"
          },
          {
            "name": "Variance to Target %",
            "expression": "DIVIDE ( [Variance to Target], [Target Sales] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "3 Plan"
          },
          {
            "name": "Target YTD",
            "expression": "TOTALYTD ( [Target Sales], 'Date'[Date] )",
            "formatString": "#,0",
            "displayFolder": "3 Plan"
          }
        ]
      },
      {
        "name": "baraka-targets",
        "columns": [
          {
            "name": "month",
            "dataType": "dateTime",
            "sourceColumn": "month",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "segment",
            "dataType": "string",
            "sourceColumn": "segment",
            "summarizeBy": "none",
